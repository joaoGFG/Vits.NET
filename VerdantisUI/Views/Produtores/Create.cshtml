@model VerdantisUI.Models.ProdutorCreateViewModel
@{
    ViewData["Title"] = "Cadastrar Produtor";
}

<div class="container mt-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Produtores</a></li>
            <li class="breadcrumb-item active">Novo</li>
        </ol>
    </nav>

    <!-- Cabeçalho -->
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-5 text-success">
                <i class="bi bi-person-plus-fill"></i> Cadastrar Novo Produtor
            </h1>
            <p class="text-muted">Preencha os dados abaixo para cadastrar um produtor</p>
        </div>
    </div>

    <!-- Formulário -->
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-card-list"></i> Dados do Produtor</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Nome -->
                        <div class="mb-3">
                            <label asp-for="Nome" class="form-label fw-bold"></label>
                            <input asp-for="Nome" class="form-control form-control-lg" 
                                   placeholder="Digite o nome do produtor" />
                            <span asp-validation-for="Nome" class="text-danger small"></span>
                        </div>

                        <!-- Tipo de Usuário -->
                        <div class="mb-4">
                            <label asp-for="TipoUsuarioId" class="form-label fw-bold"></label>
                            <select asp-for="TipoUsuarioId" class="form-select form-select-lg">
                                <option value="">-- Selecione --</option>
                                <option value="1">Produtor Rural</option>
                                <option value="2">Cooperativa</option>
                            </select>
                            <span asp-validation-for="TipoUsuarioId" class="text-danger small"></span>
                        </div>

                        <!-- Senha -->
                        <div class="mb-4">
                            <label asp-for="Senha" class="form-label fw-bold"></label>
                            <input asp-for="Senha" type="password" class="form-control form-control-lg" placeholder="Digite a senha" />
                            <span asp-validation-for="Senha" class="text-danger small"></span>
                        </div>

                        <!-- Botões -->
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-check-circle"></i> Cadastrar
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-x-circle"></i> Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Card de Ajuda -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-success">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="bi bi-info-circle text-success"></i> Informações</h6>
                </div>
                <div class="card-body">
                    <h6 class="text-success">Dicas de Preenchimento:</h6>
                    <ul class="small">
                        <li>O <strong>nome</strong> deve ter entre 3 e 100 caracteres</li>
                        <li>Selecione o <strong>tipo de usuário</strong> adequado</li>
                        <li>Todos os campos são obrigatórios</li>
                    </ul>
                    <hr>
                    <h6 class="text-success">Tipos Disponíveis:</h6>
                    <ul class="small">
                        <li><strong>Produtor Rural:</strong> Agricultor individual</li>
                        <li><strong>Cooperativa:</strong> Associação de produtores</li>
                    </ul>
                    <hr>
                    <p class="small text-muted mb-0">
                        <i class="bi bi-shield-check"></i> Seus dados são seguros e criptografados
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}