@model VerdantisUI.Models.ProdutorDeleteViewModel
@{
    ViewData["Title"] = "Excluir Produtor";
}

<div class="container mt-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Produtores">Produtores</a></li>
            <li class="breadcrumb-item"><a href="/Produtores/Details/@Model.Id">Detalhes</a></li>
            <li class="breadcrumb-item active">Excluir</li>
        </ol>
    </nav>

    <!-- Alerta de Aviso -->
    <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-2 me-3"></i>
        <div>
            <h5 class="alert-heading mb-1">Atenção! Ação Irreversível</h5>
            <p class="mb-0">Tem certeza de que deseja excluir este produtor? Esta ação não pode ser desfeita.</p>
        </div>
    </div>

    <!-- Card de Confirmação -->
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-trash-fill"></i> Confirmar Exclusão
                    </h5>
                </div>
                <div class="card-body">
                    <h4 class="text-center mb-4">Você está prestes a excluir:</h4>

                    <div class="card bg-light mb-4">
                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-4">ID:</dt>
                                <dd class="col-sm-8"><strong>#@Model.Id</strong></dd>

                                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Nome):</dt>
                                <dd class="col-sm-8">
                                    <h5 class="text-danger mb-0">@Model.Nome</h5>
                                </dd>

                                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.DataCadastro):</dt>
                                <dd class="col-sm-8">@Model.DataCadastro.ToString("dd/MM/yyyy HH:mm")</dd>

                                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.TipoUsuarioId):</dt>
                                <dd class="col-sm-8">
                                    <span class="badge bg-secondary">
                                        @if (Model.TipoUsuarioId == 1)
                                        {
                                            <text>Produtor Rural</text>
                                        }
                                        else if (Model.TipoUsuarioId == 2)
                                        {
                                            <text>Cooperativa</text>
                                        }
                                        else
                                        {
                                            <text>Tipo @Model.TipoUsuarioId</text>
                                        }
                                    </span>
                                </dd>
                            </dl>
                        </div>
                    </div>

                    <form action="/Produtores/Delete/@Model.Id" method="post">
                        @Html.AntiForgeryToken()

                        <div class="d-flex gap-3 justify-content-center">
                            <button type="submit" class="btn btn-danger btn-lg px-5">
                                <i class="bi bi-trash-fill"></i> Sim, Excluir Definitivamente
                            </button>
                            <a href="/Produtores/Details/@Model.Id" class="btn btn-outline-secondary btn-lg px-5">
                                <i class="bi bi-x-circle"></i> Não, Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>